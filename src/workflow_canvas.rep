// The view contract (QtRO). SLOTs are callable from QML; PROPs auto-sync to
// the QML replica, so results reach the view with no polling. The backend is
// the only writer of PROPs; QML only reads them.
//
// Everything crosses as JSON text rather than QJson* types: the replica is a
// process boundary, and a JSON string is the one shape both halves and the
// three workflow modules already agree on.
class WorkflowCanvas
{
    // The node palette, as published by workflow_registry. JSON array.
    PROP(QString nodeTypeDefinitions="[]" READONLY)

    // "connected" once the registry has answered, "no_registry" when it is
    // installed but not responding, "disconnected" before the first attempt.
    PROP(QString connectionStatus="disconnected" READONLY)

    // The most recent execution result, as returned by workflow_engine. JSON
    // object, or empty when cleared. QML reads nodeResults out of this to
    // light up the graph.
    PROP(QString lastExecutionResult="" READONLY)

    // The last 100 execution results, newest first. JSON array.
    PROP(QString executionHistory="[]" READONLY)

    // Re-query workflow_registry for the palette.
    SLOT(void refreshNodeTypes())

    // Hand a serialized workflow to workflow_engine. The result lands on
    // lastExecutionResult and is prepended to executionHistory.
    SLOT(void executeWorkflow(const QString &workflowJson))
    SLOT(void clearLastExecutionResult())

    // Hand a workflow to workflow_scheduler for unattended running.
    SLOT(void deployWorkflow(const QString &workflowId, const QString &workflowJson))

    // Persistence, under the host-provided per-instance data directory.
    SLOT(void saveWorkflow(const QString &name, const QString &workflowJson))
    SLOT(QString loadWorkflow(const QString &name))
    SLOT(QStringList listSavedWorkflows())
    SLOT(void deleteWorkflow(const QString &name))
}
